<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/sukun_notification_bg"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="10dp"
    android:paddingEnd="12dp"
    android:paddingBottom="10dp">

    <!-- Header Satırı: Logo / Konum ve Geri Sayım -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/notif_collapsed_location"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="SÜKÛN • İstanbul"
            android:textColor="#D4AF6A"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/notif_collapsed_countdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="İkindi: 02:14:35"
            android:textColor="#1FA87C"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 6 Vakit Yatay Şerit -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <!-- İmsak -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="İmsak"
                android:textColor="#859993"
                android:textSize="9sp" />
            <TextView
                android:id="@+id/notif_collapsed_fajr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="06:05"
                android:textColor="#F0EFEA"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Güneş -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Güneş"
                android:textColor="#859993"
                android:textSize="9sp" />
            <TextView
                android:id="@+id/notif_collapsed_sunrise"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="07:32"
                android:textColor="#F0EFEA"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Öğle -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Öğle"
                android:textColor="#859993"
                android:textSize="9sp" />
            <TextView
                android:id="@+id/notif_collapsed_dhuhr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="13:02"
                android:textColor="#F0EFEA"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- İkindi -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="İkindi"
                android:textColor="#859993"
                android:textSize="9sp" />
            <TextView
                android:id="@+id/notif_collapsed_asr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="15:44"
                android:textColor="#F0EFEA"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Akşam -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Akşam"
                android:textColor="#859993"
                android:textSize="9sp" />
            <TextView
                android:id="@+id/notif_collapsed_maghrib"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="18:12"
                android:textColor="#F0EFEA"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Yatsı -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Yatsı"
                android:textColor="#859993"
                android:textSize="9sp" />
            <TextView
                android:id="@+id/notif_collapsed_isha"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="19:38"
                android:textColor="#F0EFEA"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>

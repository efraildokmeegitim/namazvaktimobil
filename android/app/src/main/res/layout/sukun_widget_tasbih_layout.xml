<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_tasbih_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/sukun_widget_bg"
    android:paddingStart="14dp"
    android:paddingTop="12dp"
    android:paddingEnd="14dp"
    android:paddingBottom="12dp">

    <!-- Header bar: Title & Reset Button -->
    <LinearLayout
        android:id="@+id/widget_tasbih_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_tasbih_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:letterSpacing="0.06"
            android:maxLines="1"
            android:text="✦ SÜKÛN ZİKİR"
            android:textColor="#E5C170"
            android:textSize="11sp"
            android:textStyle="bold" />

        <!-- Reset Button -->
        <ImageButton
            android:id="@+id/widget_tasbih_btn_reset"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="@drawable/sukun_widget_circle_btn"
            android:contentDescription="Sıfırla"
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_widget_reset" />
    </LinearLayout>

    <!-- Dhikr Name Subtitle -->
    <TextView
        android:id="@+id/widget_tasbih_dhikr_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/widget_tasbih_header"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:text="Sübhânallâhi ve bi-hamdihî"
        android:textColor="#A2BDB2"
        android:textSize="11sp" />

    <!-- Center Tap / Counter Ring Dial -->
    <LinearLayout
        android:id="@+id/widget_tasbih_btn_tap"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/widget_tasbih_dhikr_name"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="92dp"
            android:layout_height="92dp"
            android:background="@drawable/sukun_widget_tasbih_ring"
            android:gravity="center"
            android:orientation="vertical">

            <!-- Count Number -->
            <TextView
                android:id="@+id/widget_tasbih_counter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="33"
                android:textColor="#4EEDB0"
                android:textSize="36sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_tasbih_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.04"
                android:text="DOKUN"
                android:textColor="#88AB9C"
                android:textSize="8sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

</RelativeLayout>

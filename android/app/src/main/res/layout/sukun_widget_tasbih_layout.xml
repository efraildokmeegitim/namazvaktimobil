<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_tasbih_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/sukun_widget_bg"
    android:padding="12dp">

    <!-- Header bar: Title & Reset Button -->
    <LinearLayout
        android:id="@+id/widget_tasbih_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_tasbih_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="✦ SÜKÛN ZİKİRMATİK"
            android:textColor="#E5A93C"
            android:textSize="11sp"
            android:textStyle="bold" />

        <!-- Reset Button -->
        <ImageButton
            android:id="@+id/widget_tasbih_btn_reset"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/sukun_widget_circle_btn"
            android:contentDescription="Sıfırla"
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_widget_reset" />
    </LinearLayout>

    <!-- Center Tap / Counter Area -->
    <LinearLayout
        android:id="@+id/widget_tasbih_btn_tap"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/widget_tasbih_header"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_tasbih_dhikr_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Sübhânallâhi ve bi-hamdihî"
            android:textColor="#88A096"
            android:textSize="12sp" />

        <!-- Count Number -->
        <TextView
            android:id="@+id/widget_tasbih_counter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="33"
            android:textColor="#3DDC84"
            android:textSize="44sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_tasbih_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Artırmak için dokunun"
            android:textColor="#5A7369"
            android:textSize="10sp" />
    </LinearLayout>

</RelativeLayout>
